PINGDOU_ENV=development
PINGDOU_DATABASE_URL=mysql+pymysql://pingdou:pingdou_dev@127.0.0.1:3306/pingdou?charset=utf8mb4
PINGDOU_REDIS_URL=redis://localhost:6379/0
PINGDOU_SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
PINGDOU_STORAGE_DIR=./storage
PINGDOU_PUBLIC_BASE_URL=http://localhost:8000
PINGDOU_JOB_EAGER=true
PINGDOU_FAKE_SMS_CODE=123456
PINGDOU_MINIO_ENDPOINT=localhost:9000
PINGDOU_MINIO_ACCESS_KEY=minioadmin
PINGDOU_MINIO_SECRET_KEY=minioadmin
PINGDOU_MINIO_BUCKET=pingdou
PINGDOU_MINIO_SECURE=false
